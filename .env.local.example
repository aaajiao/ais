# Supabase
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx

# AI
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Auth (comma-separated email allowlist)
# IMPORTANT — 必须配置 BOTH 两个变量，值保持一致：
#   ALLOWED_EMAILS       服务端检查（实际安全边界）
#   VITE_ALLOWED_EMAILS  客户端检查（仅 UX 反馈，会打包进客户端 JS）
# v1.3.5 起：production 部署如果 ALLOWED_EMAILS 缺失会 fail-closed
# 拒绝所有 auth（CRITICAL log）。本地 dev 缺失则只会 warn 后放行。
ALLOWED_EMAILS=user1@example.com,user2@example.com
VITE_ALLOWED_EMAILS=user1@example.com,user2@example.com

# Context7 (获取最新库文档)
CONTEXT7_API_KEY=ctx7sk-xxx

# 备份系统 (migration 009 起)
# BLOB_READ_WRITE_TOKEN: 在 Vercel Dashboard 创建 Private Blob Store 并连到本项目后，
# Vercel 自动注入到三套环境。本地用 `vercel env pull` 同步下来。
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# CRON_SECRET: 在 Vercel Dashboard 手动添加。生成: openssl rand -hex 32
# Vercel Cron 调 /api/cron/backup 时自动注入到 Authorization Bearer header；本地不需要。
CRON_SECRET=xxx
